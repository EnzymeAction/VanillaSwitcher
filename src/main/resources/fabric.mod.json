{
  "schemaVersion": 1,
  "id": "vanillaswitcher",
  "version": "${version}",
  "name": "Vanilla Switcher",
  "description": "A client-side mod that allows you to switch between configurable PvP Mode and Vanilla Minecraft.",
  "authors": [
    "you"
  ],
  "contact": {},
  "license": "CC-BY-NC-4.0",
  "icon": "assets/vanillaswitcher/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vanillaswitcher.VanillaSwitcherClient"
    ]
  },
  "mixins": [
    "vanillaswitcher.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
